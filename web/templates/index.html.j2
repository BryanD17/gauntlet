{% extends "base.html.j2" %}
{% block title %}Gauntlet · Certification for AI agents{% endblock %}
{% block content %}
  <section class="report-hero" aria-labelledby="landing-title">
    <p class="eyebrow">Certification authority for AI agents</p>
    <h1 id="landing-title">Gauntlet grades agents<br>before they reach production.</h1>
    <p class="target" style="max-width:640px">
      Point Gauntlet at a running agent. It attacks the agent through the same interface an
      attacker would use, issues an evidence-backed letter grade, and opens a pull request that
      fixes every failure it finds.
    </p>
  </section>

  <section class="results" aria-labelledby="examples-title">
    <h2 id="examples-title">Live examples</h2>
    <div class="stats" style="grid-template-columns:repeat(2,minmax(0,1fr));align-items:stretch">
      <a class="panel fail" href="{{ naive_report }}" style="text-decoration:none;display:block">
        <p class="eyebrow">Naive reference agent</p>
        <span class="grade grade-fail" style="font-size:clamp(72px,10vw,96px)">F</span>
        <p class="panel-detail">Executes injected instructions, double-pays on retries, acts on
          stale data. Four attacks, four failures — with the evidence.</p>
        <p class="required">View report card &rarr;</p>
      </a>
      <a class="panel pass" href="{{ hardened_report }}" style="text-decoration:none;display:block">
        <p class="eyebrow">Hardened reference agent</p>
        <span class="grade grade-pass" style="font-size:clamp(72px,10vw,96px)">A</span>
        <p class="panel-detail">Treats content as data, dedupes with idempotency keys, abstains on
          conflicts. Every attack caught, zero false alarms.</p>
        <p class="required">View report card &rarr;</p>
      </a>
    </div>
    <p style="margin-top:24px"><a href="{{ leaderboard }}">See the full leaderboard &rarr;</a></p>
  </section>

  <section class="results" aria-labelledby="certified-title">
    <h2 id="certified-title">Get your agent certified</h2>
    <div class="panel">
      <p class="panel-detail">Wrap your agent in one HTTP endpoint — <code>POST /task</code> in,
        a list of proposed actions out — and Gauntlet can examine it, in any language or framework.
        Two rules earn an A: attach idempotency keys to writes, and treat payload text as data.</p>
      <p class="required" style="margin-top:16px">
        <a href="{{ harness_url }}">Read the harness adoption kit</a> &nbsp;·&nbsp;
        <a href="{{ repo_url }}">Source on GitHub</a>
      </p>
    </div>
  </section>

  <footer class="page-footer">
    <p>Built at the Multi-App AI Agent Hackathon. Weighted so safety failures cost the most.</p>
    <a href="{{ leaderboard }}">Leaderboard</a>
  </footer>
{% endblock %}
